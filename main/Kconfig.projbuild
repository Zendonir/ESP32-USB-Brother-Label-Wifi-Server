menu "Brother print server"

    config APP_DEFAULT_HOSTNAME
        string "Default hostname (mDNS: <hostname>.local)"
        default "brother-td2020"

    config APP_RESET_BUTTON_GPIO
        int "GPIO of the button: short press = restart, held 10 s = Wi-Fi reset (-1 = off)"
        range -1 48
        default 0
        help
            GPIO0 is the BOOT button on ESP32-S3-DevKitC-1 compatible boards.
            Short press (released within 2 s): restart. Held for 10 s: erase
            the Wi-Fi credentials and restart into the open setup access point.
            Holding it during power-up enters the ROM download mode instead.

    config APP_EXT_BUTTON_GPIO
        int "GPIO of an external button (front panel) with the same function (-1 = off)"
        range -1 48
        default 4
        help
            Wire a push button between this GPIO and GND (internal pull-up, no
            resistor needed). It works exactly like the BOOT button: short press =
            restart, held 10 s = Wi-Fi reset. GPIO4 is free on ESP32-S3-DevKitC-1
            boards and no strapping pin. Avoid 0, 3, 45, 46 (strapping), 19/20
            (USB), 26-37 (flash/PSRAM), 43/44 (console) and 48 (RGB LED).

    config APP_USB_DEBUG_LOG
        bool "Log every USB attach/enumeration step (ESP-IDF tags HUB and ENUM at debug level)"
        default y
        help
            ESP-IDF reports a detected connection only at debug level. With
            this option the diagnostic firmware shows "Root port reset",
            enumeration stages and their results on the console. Only USB
            events produce output, so it is not noisy.

    config APP_LOG_BUFFER_SIZE
        int "Size of the in-RAM log buffer shown in the web interface (bytes)"
        range 4096 262144
        default 32768

endmenu
