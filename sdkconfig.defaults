# ---- Target / flash: ESP32-S3-DevKitC-1 clone, WROOM-1-N16R8 module (16 MB quad flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM (octal on the R8 variant)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Console on UART0 (the "COM"/UART USB-C port).
# The native USB port (GPIO19/20) is used by the USB OTG host controller and
# therefore cannot be used for USB-Serial-JTAG console at the same time.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_COLORS=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Debug messages compiled in so that 'log_level <tag> debug' works at runtime
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- FreeRTOS / system
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# ---- Prepared for OTA in later phases
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- USB host
# Buffer for enumeration control transfers (default 256). Larger so that a long
# configuration descriptor does not make enumeration fail.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
