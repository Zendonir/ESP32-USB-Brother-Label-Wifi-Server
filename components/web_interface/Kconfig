menu "Diagnostic web interface"

    config DIAG_ENABLE_RAW_SEND
        bool "Compile in POST /api/diag/raw (forward request body unchanged to the printer)"
        default y
        help
            Development aid for phase 3: lets you send a print file that was
            produced by the ORIGINAL Brother driver ("print to file") to the
            printer. The endpoint is OFF after every boot and must be enabled
            on the serial console with 'raw_send on'. There is no
            authentication and no queue in this phase.

    config DIAG_RAW_SEND_MAX_BYTES
        int "Maximum body size for /api/diag/raw"
        depends on DIAG_ENABLE_RAW_SEND
        range 1024 16777216
        default 4194304

    config DIAG_RAW_SEND_TIMEOUT_MS
        int "USB timeout per chunk for /api/diag/raw (ms)"
        depends on DIAG_ENABLE_RAW_SEND
        range 1000 600000
        default 30000

endmenu
